generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                String     @id @default(uuid())
  email             String     @unique
  password          String
  fullName          String?    @map("full_name")
  isVerified        Boolean    @default(false) @map("is_verified")
  verificationToken String?    @map("verification_token")
  // Customer country (ISO-2) for country-aware supplier discovery.
  countryCode       String?    @map("country_code")
  createdAt         DateTime   @default(now()) @map("created_at")

  orders     Order[]
  supplier   Supplier?
  roles      UserRole[]
  designs    Design[]
  reviews    Review[]
  cart       Cart?

  @@map("profiles")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user  Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id            String   @id @default(uuid())
  cartId        String   @map("cart_id")
  designId      String?  @map("design_id")
  productId     String?  @map("product_id")
  supplierId    String?  @map("supplier_id")
  quantity      Int
  currency      String   @default("EUR")
  optionsJson   String?  @map("options_json")
  priceSnapshot Float    @default(0) @map("price_snapshot")
  createdAt     DateTime @default(now()) @map("created_at")

  cart   Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  design Design? @relation(fields: [designId], references: [id])

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                     String    @id @default(uuid())
  userId                 String    @map("user_id")
  designId               String?   @map("design_id")
  supplierId             String?   @map("supplier_id")
  productId              String?   @map("product_id")

  quantity               Int
  totalPrice             Float     @map("total_price")
  unitPrice              Float?    @map("unit_price")
  basePrice              Float?    @map("base_price")

  status                 String
  paymentStatus          String?   @map("payment_status")
  currency               String

  printType              String?   @map("print_type")
  hasSecureGuests        Boolean?  @map("has_secure_guests")

  shippingAddress        String?   @map("shipping_address")
  extraCharges           String?   @map("extra_charges")
  adminNotes             String?   @map("admin_notes")
  customizationNotes     String?   @map("customization_notes")
  wristbandSize          String?   @map("wristband_size")

  stripePaymentIntentId  String?   @map("stripe_payment_intent_id")
  stripeSessionId        String?   @map("stripe_session_id")
  trackingNumber         String?   @map("tracking_number")
  trackingUrl            String?   @map("tracking_url")
  courier                String?
  estimatedDelivery      DateTime? @map("estimated_delivery")
  shippedAt              DateTime? @map("shipped_at")
  deliveredAt            DateTime? @map("delivered_at")
  pricingSnapshotJson    String?   @map("pricing_snapshot_json")
  designSnapshotJson     String?   @map("design_snapshot_json")

  // Manual payment: the method the customer chose to pay with, and the proof-of-
  // payment receipt they uploaded for the supplier to review before confirming.
  paymentMethodProvider    String?   @map("payment_method_provider")
  paymentReceiptUrl        String?   @map("payment_receipt_url")
  paymentReceiptUploadedAt DateTime? @map("payment_receipt_uploaded_at")

  createdAt              DateTime  @default(now()) @map("created_at")

  user       Profile   @relation(fields: [userId], references: [id])
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  design     Design?   @relation(fields: [designId], references: [id])
  product    Product?  @relation(fields: [productId], references: [id])
  statusHistory OrderStatusHistory[]

  @@map("orders")
}

model OrderStatusHistory {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  note        String?
  updatedByUserId String? @map("updated_by_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

model Design {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  productId         String?   @map("product_id")
  designName        String?   @map("design_name")

  designUrl         String    @map("design_url")
  customText        String?   @map("custom_text")
  textColor         String?   @map("text_color")
  textPosition      String?   @map("text_position")
  fontFamily        String?   @default("Arial") @map("font_family")
  fontSize          Int?      @default(14) @map("font_size")

  logoUrl           String?   @map("logo_url")
  logoPosition      String?   @map("logo_position")
  logoScale         Float?    @default(1.0) @map("logo_scale")

  wristbandColor    String?   @map("wristband_color")
  wristbandType     String?   @map("wristband_type")
  wristbandSize     String?   @default("M") @map("wristband_size")
  customWidthMm     Float?    @map("custom_width_mm")

  innerText         String?   @map("inner_text")
  innerTextColor    String?   @default("#FFFFFF") @map("inner_text_color")
  pattern           String?   @default("solid")
  secondaryColor    String?   @map("secondary_color")

  clipArtId         String?   @map("clip_art_id")
  clipArtPosition   String?   @map("clip_art_position")

  canvasJson        String?   @map("canvas_json")
  // Full customization snapshot (options, pricing, supplier/product) as JSON.
  // Lets the studio restore a design exactly and the supplier see every detail.
  metaJson          String?   @map("meta_json")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user         Profile       @relation(fields: [userId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  orders       Order[]
  designImages DesignImage[]
  cartItems    CartItem[]

  @@map("designs")
}

model DesignImage {
  id         String @id @default(uuid())
  designId   String @map("design_id")
  imageUrl   String @map("image_url")
  imageType  String @default("logo") @map("image_type") // logo, clip_art, pattern, background
  position   String @default("{\"x\": 50, \"y\": 50}")
  scale      Float  @default(1.0)
  rotation   Float  @default(0)
  layerOrder Int    @default(0) @map("layer_order")

  createdAt DateTime @default(now()) @map("created_at")

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@map("design_images")
}

model Supplier {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")

  companyName   String   @map("company_name")
  contactEmail  String   @map("contact_email")
  contactPhone  String?  @map("contact_phone")
  address       String?  @map("address")
  logoUrl       String?  @map("logo_url")
  description   String?
  website       String?
  city          String?
  country       String?
  rating        Float    @default(0)
  reviewCount   Int      @default(0) @map("review_count")
  totalOrders   Int      @default(0) @map("total_orders")
  isVerified    Boolean  @default(false) @map("is_verified")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Normalized location. `countryCode` (ISO-2, FK -> Country) is the source of
  // truth going forward; the legacy `country`/`city` strings above are retained
  // during the transition and mirrored from these on write.
  countryCode   String?  @map("country_code")
  state         String?

  // Admin lifecycle: ACTIVE | SUSPENDED. Suspended suppliers keep read access
  // but cannot create products or accept new orders.
  status        String   @default("ACTIVE")

  // ---- Wholesaler / production model -------------------------------------
  // A wholesaler is a Supplier flagged `isWholesaler`: it sells to other
  // suppliers (not end customers) and reuses the full product/options/pricing
  // engine for its catalog. The platform's own production is the single
  // `isHouseWholesaler` account, used as the fallback when a supplier has no
  // wholesaler assigned. Becoming a wholesaler is admin-gated.
  isWholesaler      Boolean @default(false) @map("is_wholesaler")
  isHouseWholesaler Boolean @default(false) @map("is_house_wholesaler")
  // Whether this supplier manufactures in-house. When false, they must place a
  // wholesale order to fulfil each customer order (enforced on order accept).
  hasOwnProduction  Boolean @default(true) @map("has_own_production")
  // Admin-assigned wholesaler this supplier orders from. Null → house wholesaler.
  wholesalerId      String? @map("wholesaler_id")

  user           Profile         @relation(fields: [userId], references: [id])
  countryRef     Country?        @relation(fields: [countryCode], references: [code])
  orders         Order[]
  products       Product[]
  pricingConfigs PricingConfig[]
  reviews        Review[]
  subscription   Subscription?
  paymentMethods SupplierPaymentMethod[]
  transactions   PaymentTransaction[]
  shippingRates  ShippingRate[]

  // Wholesaler assignment (self-relation).
  assignedWholesaler Supplier?  @relation("SupplierWholesaler", fields: [wholesalerId], references: [id])
  assignedSuppliers  Supplier[] @relation("SupplierWholesaler")

  // As a wholesaler: discounts + offers it grants, and orders it receives.
  discountsGranted   SupplierDiscount[] @relation("WholesalerDiscounts")
  offers             WholesalerOffer[]
  wholesaleOrdersReceived WholesaleOrder[] @relation("WholesaleSeller")
  // As a buyer: discounts targeted at it, and wholesale orders it placed.
  discountsReceived  SupplierDiscount[] @relation("SupplierDiscounts")
  wholesaleOrdersPlaced   WholesaleOrder[] @relation("WholesaleBuyer")

  // As EUP: the price lists + freight rates it sets for the suppliers it sells to.
  eupPricesSet       EupPrice[]       @relation("EupPriceSeller")
  eupFreightSet      EupFreightRate[] @relation("EupFreightSeller")
  // As a supplier buying from EUP: prices + freight targeted at this account.
  eupPricesReceived  EupPrice[]       @relation("EupPriceBuyer")
  eupFreightReceived EupFreightRate[] @relation("EupFreightBuyer")

  @@index([countryCode])
  @@index([status])
  @@index([isWholesaler])
  @@index([wholesalerId])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// Per-supplier delivery: couriers with quantity-tiered rates.
// A supplier can offer several couriers (DHL, FedEx, …); one is the default.
// Each courier has one or more quantity tiers (a flat rate is just a single
// tier with minQuantity=1 and no max). Optional free-shipping-over-quantity
// threshold and estimated delivery window.
// ---------------------------------------------------------------------------

model ShippingRate {
  id          String   @id @default(uuid())
  supplierId  String   @map("supplier_id")
  courier     String
  label       String?
  freeOverQty Int?     @map("free_over_qty")
  estMinDays  Int?     @map("est_min_days")
  estMaxDays  Int?     @map("est_max_days")
  isActive    Boolean  @default(true) @map("is_active")
  isDefault   Boolean  @default(false) @map("is_default")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  supplier Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tiers    ShippingRateTier[]

  @@index([supplierId])
  @@map("shipping_rates")
}

model ShippingRateTier {
  id             String @id @default(uuid())
  shippingRateId String @map("shipping_rate_id")
  minQuantity    Int    @map("min_quantity")
  maxQuantity    Int?   @map("max_quantity")
  priceEur       Float  @map("price_eur")
  priceUsd       Float? @map("price_usd")
  priceGbp       Float? @map("price_gbp")

  createdAt DateTime @default(now()) @map("created_at")

  shippingRate ShippingRate @relation(fields: [shippingRateId], references: [id], onDelete: Cascade)

  @@index([shippingRateId])
  @@map("shipping_rate_tiers")
}

// ---------------------------------------------------------------------------
// SaaS: subscription plans, subscriptions, billing history
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String?
  priceUsd      Float    @default(0) @map("price_usd")
  priceEur      Float?   @map("price_eur")
  priceGbp      Float?   @map("price_gbp")
  interval      String   @default("month") // month | year
  trialDays     Int      @default(30) @map("trial_days")
  isActive      Boolean  @default(true) @map("is_active")
  stripePriceId String?  @map("stripe_price_id")
  featuresJson  String?  @map("features_json")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                   String    @id @default(uuid())
  supplierId           String    @unique @map("supplier_id")
  planId               String    @map("plan_id")
  couponId             String?   @map("coupon_id")
  // TRIALING | ACTIVE | PAST_DUE | CANCELED | EXPIRED
  status               String    @default("TRIALING")
  currentPeriodStart   DateTime  @default(now()) @map("current_period_start")
  currentPeriodEnd     DateTime  @map("current_period_end")
  trialEndsAt          DateTime? @map("trial_ends_at")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime? @map("canceled_at")
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  supplier Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan      @relation(fields: [planId], references: [id])
  coupon   Coupon?               @relation(fields: [couponId], references: [id])
  payments SubscriptionPayment[]

  @@index([status])
  @@map("subscriptions")
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String?
  // percent | fixed
  discountType   String    @default("percent") @map("discount_type")
  discountValue  Float     @map("discount_value")
  isActive       Boolean   @default(true) @map("is_active")
  expiresAt      DateTime? @map("expires_at")
  maxRedemptions Int?      @map("max_redemptions")
  timesRedeemed  Int       @default(0) @map("times_redeemed")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("coupons")
}

model TaxRate {
  id          String   @id @default(uuid())
  countryCode String   @unique @map("country_code")
  name        String
  ratePercent Float    @map("rate_percent")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("tax_rates")
}

model SubscriptionPayment {
  id              String    @id @default(uuid())
  subscriptionId  String    @map("subscription_id")
  supplierId      String    @map("supplier_id")
  amount          Float     @default(0)
  discountAmount  Float     @default(0) @map("discount_amount")
  taxAmount       Float     @default(0) @map("tax_amount")
  currency        String    @default("EUR")
  // PAID | FAILED | PENDING | REFUNDED
  status          String    @default("PAID")
  periodStart     DateTime? @map("period_start")
  periodEnd       DateTime? @map("period_end")
  stripeInvoiceId String?   @map("stripe_invoice_id")
  paidAt          DateTime? @map("paid_at")
  failureReason   String?   @map("failure_reason")
  createdAt       DateTime  @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("subscription_payments")
}

// ---------------------------------------------------------------------------
// Per-supplier payment methods + customer->supplier transactions
// (schema laid down in Phase 1; live charge flow lands in Phase 2)
// ---------------------------------------------------------------------------

model SupplierPaymentMethod {
  id              String   @id @default(uuid())
  supplierId      String   @map("supplier_id")
  // STRIPE_CONNECT | PAYPAL | PAYONEER | BANK_TRANSFER | JAZZCASH | EASYPAISA | MANUAL
  provider        String
  label           String?
  isDefault       Boolean  @default(false) @map("is_default")
  isActive        Boolean  @default(true) @map("is_active")
  // PENDING | CONNECTED | DISABLED
  status          String   @default("PENDING")
  // AES-256-GCM ciphertext of the provider config (keys, bank/wallet details).
  configEncrypted String?  @map("config_encrypted")
  // Stripe Connect account id is not secret, kept in the clear for lookups.
  stripeAccountId String?  @map("stripe_account_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_payment_methods")
}

model PaymentTransaction {
  id                    String   @id @default(uuid())
  orderId               String?  @map("order_id")
  supplierId            String   @map("supplier_id")
  paymentMethodId       String?  @map("payment_method_id")
  provider              String
  amount                Float    @default(0)
  currency              String   @default("EUR")
  // PENDING | PAID | FAILED | REFUNDED
  status                String   @default("PENDING")
  stripePaymentIntentId String?  @map("stripe_payment_intent_id")
  platformFeeAmount     Float?   @map("platform_fee_amount")
  createdAt             DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([orderId])
  @@map("payment_transactions")
}

// ---------------------------------------------------------------------------
// Reference data + audit trail
// ---------------------------------------------------------------------------

model Country {
  code     String  @id // ISO-3166 alpha-2
  name     String
  region   String?
  currency String?
  isActive Boolean @default(true) @map("is_active")

  suppliers Supplier[]

  @@map("countries")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?  @map("actor_user_id")
  actorRole    String?  @map("actor_role")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  metadataJson String?  @map("metadata_json")
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

model Review {
  id         String   @id @default(uuid())
  supplierId String   @map("supplier_id")
  userId     String   @map("user_id")
  orderId    String?  @map("order_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  user     Profile  @relation(fields: [userId], references: [id])

  @@index([supplierId])
  @@map("reviews")
}

model Product {
  id           String  @id @default(uuid())
  supplierId   String  @map("supplier_id")
  name         String
  description  String?
  wristbandType String @map("wristband_type")

  // Supplier-set pricing
  priceUsd Float @map("price_usd")
  priceEur Float? @map("price_eur")
  priceGbp Float? @map("price_gbp")

  // Customization pricing add-ons
  printExtraUsd      Float @default(0) @map("print_extra_usd")
  colorPrintExtraUsd Float @default(0) @map("color_print_extra_usd")
  logoExtraUsd       Float @default(0) @map("logo_extra_usd")

  // Dynamic pricing engine add-ons (per-currency)
  // Design setup: one-time flat fee applied per order when a custom design is used
  designSetupFeeUsd Float  @default(0) @map("design_setup_fee_usd")
  designSetupFeeEur Float? @map("design_setup_fee_eur")
  designSetupFeeGbp Float? @map("design_setup_fee_gbp")

  // QR code: charged per unit (per wristband) when QR is enabled
  qrCodePriceUsd Float  @default(0) @map("qr_code_price_usd")
  qrCodePriceEur Float? @map("qr_code_price_eur")
  qrCodePriceGbp Float? @map("qr_code_price_gbp")

  // Trademark / branding: one-time flat fee applied per order when enabled
  trademarkFeeUsd Float  @default(0) @map("trademark_fee_usd")
  trademarkFeeEur Float? @map("trademark_fee_eur")
  trademarkFeeGbp Float? @map("trademark_fee_gbp")

  minOrderQuantity Int      @default(1) @map("min_order_quantity")
  maxOrderQuantity Int?     @map("max_order_quantity")
  isActive         Boolean  @default(true) @map("is_active")
  // Supplier-controlled position in their product list (lower = first).
  sortOrder        Int      @default(0) @map("sort_order")
  imageUrls        String   @default("[]") @map("image_urls") // JSON string

  // Customization flags
  allowsCustomText  Boolean @default(true) @map("allows_custom_text")
  allowsCustomColor Boolean @default(true) @map("allows_custom_color")
  allowsLogoUpload  Boolean @default(true) @map("allows_logo_upload")
  allowsInnerText   Boolean @default(false) @map("allows_inner_text")
  availableSizes    String  @default("[\"S\",\"M\",\"L\",\"XL\"]") @map("available_sizes")
  availableColors   String  @default("[]") @map("available_colors")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplier     Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  pricingTiers SupplierPricingTier[]
  options      ProductOption[]
  designs      Design[]
  orders       Order[]
  eupPrices    EupPrice[]

  @@map("products")
}

/// A supplier-configured customization add-on for a product (e.g. "Full-colour
/// print", "RFID Sticker"). Fully dynamic: suppliers can rename, price, reorder,
/// disable, and create unlimited options without code changes. Replaces the
/// legacy fixed add-on columns on Product (kept for backward compatibility —
/// see product-options synthesis in the pricing module).
model ProductOption {
  id          String  @id @default(uuid())
  productId   String  @map("product_id")
  /// Stable machine key (slug). Default template options use well-known keys
  /// (black_print, full_color_print, logo_print, qr_code, design_setup,
  /// trademark); custom options get generated slugs.
  key         String
  label       String
  description String?
  /// Optional display group, e.g. "Print", "Codes & tracking".
  groupName   String? @map("group_name")
  /// per_unit → multiplied by order quantity; one_time → flat fee per order.
  pricingMode String  @default("per_unit") @map("pricing_mode")
  priceUsd    Float   @default(0) @map("price_usd")
  priceEur    Float?  @map("price_eur")
  priceGbp    Float?  @map("price_gbp")
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")
  /// How the Design Studio renders this option:
  /// toggle (generic checkbox) | print (artwork/logo upload) | qr | trademark
  /// | design_setup (auto-applied when the customer customizes the design).
  studioModule String @default("toggle") @map("studio_module")
  /// Optional sub-choices as JSON: [{key,label,description?,priceUsd?,priceEur?,priceGbp?}].
  /// A selected choice's price overrides the option price when provided.
  choicesJson String? @map("choices_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([productId])
  @@map("product_options")
}

model SupplierPricingTier {
  id              String @id @default(uuid())
  productId       String @map("product_id")
  minQuantity     Int    @map("min_quantity")
  maxQuantity     Int?   @map("max_quantity")
  pricePerUnitUsd Float  @map("price_per_unit_usd")
  pricePerUnitEur Float? @map("price_per_unit_eur")
  pricePerUnitGbp Float? @map("price_per_unit_gbp")

  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("supplier_pricing_tiers")
}

model UserRole {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")

  role      String    // ✅ replaced enum

  createdAt DateTime  @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id])

  @@map("user_roles")
}

model PricingConfig {
  id                         String  @id @default(uuid())

  supplierId                 String? @map("supplier_id")

  wristbandType              String  @map("wristband_type")
  minQuantity                Int     @map("min_quantity")

  basePriceUsd               Float   @map("base_price_usd")
  basePriceEur               Float   @map("base_price_eur")
  basePriceGbp               Float   @map("base_price_gbp")

  blackPrintExtraUsd         Float   @map("black_print_extra_usd")
  blackPrintExtraEur         Float   @map("black_print_extra_eur")
  blackPrintExtraGbp         Float   @map("black_print_extra_gbp")

  fullColorPrintExtraUsd     Float   @map("full_color_print_extra_usd")
  fullColorPrintExtraEur     Float   @map("full_color_print_extra_eur")
  fullColorPrintExtraGbp     Float   @map("full_color_print_extra_gbp")

  secureGuestsExtraUsd       Float   @map("secure_guests_extra_usd")
  secureGuestsExtraEur       Float   @map("secure_guests_extra_eur")

  supplier                   Supplier? @relation(fields: [supplierId], references: [id])

  @@map("pricing_config")
}

// ---------------------------------------------------------------------------
// Wholesaler layer: discounts, promotional offers, and supplier→wholesaler
// orders. A wholesaler is a Supplier flagged `isWholesaler` (see Supplier).
// ---------------------------------------------------------------------------

/// A discount a wholesaler grants to the suppliers who buy from it. A row with
/// `supplierId = null` is the wholesaler's default discount for every supplier;
/// a row with a `supplierId` overrides the default for that specific supplier.
model SupplierDiscount {
  id           String   @id @default(uuid())
  wholesalerId String   @map("wholesaler_id")
  supplierId   String?  @map("supplier_id") // null = applies to all suppliers
  percent      Float    @default(0)
  note         String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  wholesaler Supplier  @relation("WholesalerDiscounts", fields: [wholesalerId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation("SupplierDiscounts", fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([wholesalerId, supplierId])
  @@index([wholesalerId])
  @@map("supplier_discounts")
}

/// A promotional offer a wholesaler advertises to attract suppliers. Shown as a
/// banner on the supplier's "Order from wholesaler" page. `discountPercent`, when
/// set, is applied on top of any base supplier discount (best price wins).
model WholesalerOffer {
  id              String    @id @default(uuid())
  wholesalerId    String    @map("wholesaler_id")
  title           String
  description     String?
  discountPercent Float?    @map("discount_percent")
  code            String?
  minQuantity     Int?      @map("min_quantity")
  validFrom       DateTime? @map("valid_from")
  validUntil      DateTime? @map("valid_until")
  isActive        Boolean   @default(true) @map("is_active")
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  wholesaler Supplier @relation(fields: [wholesalerId], references: [id], onDelete: Cascade)

  @@index([wholesalerId])
  @@map("wholesaler_offers")
}

/// The fixed price EUP charges a supplier for a product, quoted per 1000 pcs.
///
/// This is the source of truth for what a supplier pays EUP — deliberately NOT
/// derived from the supplier's own retail list price, so a supplier can never
/// move its own cost by editing what it charges customers. Every value here is
/// entered by EUP in its console; there are no price constants in code.
///
/// A row with `supplierId = null` is EUP's default price for that product for
/// every supplier; a row with a `supplierId` overrides it for that supplier.
/// When no row resolves, the product is simply not orderable by that supplier.
model EupPrice {
  id           String  @id @default(uuid())
  wholesalerId String  @map("wholesaler_id") // the EUP account selling
  productId    String  @map("product_id")
  supplierId   String? @map("supplier_id") // null = default for all suppliers

  pricePer1000Eur Float  @map("price_per_1000_eur")
  pricePer1000Usd Float? @map("price_per_1000_usd")
  pricePer1000Gbp Float? @map("price_per_1000_gbp")

  note      String?
  isActive  Boolean   @default(true) @map("is_active")
  validFrom DateTime? @map("valid_from")
  validUntil DateTime? @map("valid_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wholesaler Supplier  @relation("EupPriceSeller", fields: [wholesalerId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation("EupPriceBuyer", fields: [supplierId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wholesalerId, productId, supplierId])
  @@index([wholesalerId])
  @@index([productId])
  @@map("eup_prices")
}

/// Freight EUP charges a supplier, billed on top of the goods price (never baked
/// into `EupPrice`). Quoted per 1000 pcs with an optional minimum charge, and
/// optionally free above a quantity threshold.
///
/// Resolution picks the most specific active row: an exact supplier + country +
/// fulfilment-mode match beats a supplier-only row, which beats a country-only
/// row, which beats EUP's catch-all. `fulfilmentMode = 'ANY'` matches both
/// ship-to-supplier and drop-ship. When nothing matches, freight is zero.
model EupFreightRate {
  id           String  @id @default(uuid())
  wholesalerId String  @map("wholesaler_id")
  supplierId   String? @map("supplier_id") // null = applies to all suppliers
  countryCode  String? @map("country_code") // null = any destination

  // SHIP_TO_SUPPLIER | DROP_SHIP | ANY
  fulfilmentMode String  @default("ANY") @map("fulfilment_mode")
  label          String?

  pricePer1000Eur Float  @map("price_per_1000_eur")
  pricePer1000Usd Float? @map("price_per_1000_usd")
  pricePer1000Gbp Float? @map("price_per_1000_gbp")

  minChargeEur Float? @map("min_charge_eur")
  minChargeUsd Float? @map("min_charge_usd")
  minChargeGbp Float? @map("min_charge_gbp")

  freeOverQty Int? @map("free_over_qty")
  estMinDays  Int? @map("est_min_days")
  estMaxDays  Int? @map("est_max_days")

  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wholesaler Supplier  @relation("EupFreightSeller", fields: [wholesalerId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation("EupFreightBuyer", fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([wholesalerId])
  @@index([supplierId])
  @@map("eup_freight_rates")
}

/// An order a supplier places with a wholesaler — to fulfil a specific customer
/// order (`sourceOrderId`) or to restock (source null). Kept separate from the
/// customer `Order` so the two flows never entangle. The supplier can have the
/// wholesaler ship to itself (SHIP_TO_SUPPLIER) or drop-ship straight to the end
/// customer (DROP_SHIP), passing the customer's delivery + contact details.
model WholesaleOrder {
  id              String  @id @default(uuid())
  buyerSupplierId String  @map("buyer_supplier_id")
  wholesalerId    String  @map("wholesaler_id")
  productId       String? @map("product_id")
  sourceOrderId   String? @map("source_order_id")

  quantity        Int
  currency        String  @default("EUR")
  listUnitPrice   Float?  @map("list_unit_price")   // per-unit before discount
  unitPrice       Float?  @map("unit_price")        // per-unit after discount
  discountPercent Float   @default(0) @map("discount_percent")
  totalPrice      Float   @map("total_price")
  optionsJson         String? @map("options_json")
  pricingSnapshotJson String? @map("pricing_snapshot_json")

  // Goods vs freight, kept separate so the supplier always sees what EUP charged
  // for product and what it charged to ship. totalPrice = goodsTotal + freightTotal.
  eupPricePer1000 Float?  @map("eup_price_per_1000") // the EupPrice in force when ordered
  goodsTotal      Float?  @map("goods_total")
  freightTotal    Float?  @map("freight_total")
  freightRateId   String? @map("freight_rate_id")

  // SHIP_TO_SUPPLIER (default) | DROP_SHIP (deliver straight to the end customer)
  fulfilmentMode   String  @default("SHIP_TO_SUPPLIER") @map("fulfilment_mode")
  // End-customer delivery + contact details (name/phone/email/address) when drop-shipping.
  customerInfoJson String? @map("customer_info_json")
  shippingAddress  String? @map("shipping_address")

  // PLACED | ACCEPTED | IN_PRODUCTION | SHIPPED | DELIVERED | CANCELLED
  status         String  @default("PLACED")
  // Payment the buyer supplier makes to the wholesaler (mirrors customer→supplier):
  // null | awaiting_payment | paid. Method + receipt + Stripe references below.
  paymentStatus            String?   @map("payment_status")
  paymentMethodProvider    String?   @map("payment_method_provider")
  paymentReceiptUrl        String?   @map("payment_receipt_url")
  paymentReceiptUploadedAt DateTime? @map("payment_receipt_uploaded_at")
  stripeSessionId          String?   @map("stripe_session_id")
  stripePaymentIntentId    String?   @map("stripe_payment_intent_id")

  // Production SLA. EUP starts production once the supplier has paid, and
  // commits to delivery within PRODUCTION_SLA_DAYS of that payment.
  paidAt              DateTime? @map("paid_at")
  productionStartedAt DateTime? @map("production_started_at")
  promisedDeliveryAt  DateTime? @map("promised_delivery_at")
  trackingNumber String? @map("tracking_number")
  trackingUrl    String? @map("tracking_url")
  courier        String?
  notes          String?
  adminNotes     String? @map("admin_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  buyerSupplier Supplier @relation("WholesaleBuyer", fields: [buyerSupplierId], references: [id], onDelete: Cascade)
  wholesaler    Supplier @relation("WholesaleSeller", fields: [wholesalerId], references: [id], onDelete: Cascade)

  @@index([buyerSupplierId])
  @@index([wholesalerId])
  @@index([sourceOrderId])
  @@map("wholesale_orders")
}