# PostgreSQL connection string (see docker-compose.yml for a local dev instance)
DATABASE_URL="postgresql://wristband:wristband@localhost:5433/wristband?schema=public"

# Email via SMTP (nodemailer) — any provider. Leave SMTP_HOST blank in dev to use
# an Ethereal test inbox (preview URLs logged instead of real delivery).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="EU Wristbands <no-reply@yourdomain.com>"

# Secret used to sign JWT access tokens — set a strong random value in production
JWT_SECRET="change-this-to-a-strong-random-secret"

# Port the API listens on (defaults to 3000)
PORT=3000

# Stripe API keys (use test keys in dev, live keys in production)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Signing secret for the Stripe webhook (production; from `stripe listen` or the dashboard)
STRIPE_WEBHOOK_SECRET=""

# Base URL of the frontend (Stripe redirects + email confirm links; match your dev port)
CLIENT_URL="http://localhost:8081"

# --- Phase 1 SaaS foundation ---
# 32-byte key (base64 or hex) for encrypting supplier payment-method config.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""
# Subscription billing engine: "none" (schema-driven trials/renewal) or "stripe"
# (live Stripe Billing via webhook). Defaults to none.
BILLING_PROVIDER="none"
# Platform-owner (admin) account seeded by `npx ts-node prisma/seed-admin.ts`
OWNER_EMAIL="owner@wristband.local"
OWNER_PASSWORD="ChangeMe123!"
